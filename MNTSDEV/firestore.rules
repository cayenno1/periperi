rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Notifications: customers/{userId}/notifs/{notifId}
    // Only the signed-in user can read/write their own notifs.
    match /customers/{userId}/notifs/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // All other collections (orders, menu, customers, etc.) — tighten for production.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
