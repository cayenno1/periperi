rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow users to upload discount proof photos to their own folder
    match /discount-proofs/{userId}/{fileName} {
      // Allow read: if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write (upload): if user is authenticated and uploading to their own folder
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Allow users to upload payment proof photos
    match /paymentProofs/{userId}/{fileName} {
      // Allow read: if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write (upload): if user is authenticated and uploading to their own folder
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Allow read access to menu images (public read)
    match /menu/{allPaths=**} {
      allow read: if true;
      allow write: if false;  // Only admins can write via Firebase Console
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
