rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow users to upload discount proof photos to their own folder
    match /discount-proofs/{userId}/{fileName} {
      // Allow read: if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write (upload): if user is authenticated and uploading to their own folder
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Allow users to upload payment proof photos
    match /paymentProofs/{userId}/{fileName} {
      // Allow read: if user is authenticated (for viewing their own or admin viewing guest proofs)
      // OR allow read for guest folder files (for download URLs after upload)
      allow read: if request.auth != null || userId == 'guest';
      
      // Allow write (upload): if user is authenticated and uploading to their own folder
      // OR if it's a guest upload (userId == 'guest') without authentication
      allow write: if (
        // Authenticated users uploading to their own folder
        (request.auth != null && request.auth.uid == userId) ||
        // Guest users uploading to guest folder (no auth required)
        (request.auth == null && userId == 'guest')
      )
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && (
                     // Allow if content type is an image (if set)
                     !('contentType' in request.resource) ||
                     request.resource.contentType.matches('image/.*')
                   );
    }
    
    // Allow read access to menu images (public read)
    match /menu/{allPaths=**} {
      allow read: if true;
      allow write: if false;  // Only admins can write via Firebase Console
    }
    
    // Allow read access to promotion/banner images (public read for displaying banners)
    match /promotionImages/{fileName} {
      // Allow public read: banners need to be visible to all users
      allow read: if true;
      
      // Allow write (upload): Since app uses custom session auth (not Firebase Auth),
      // allow writes with file size and content type restrictions
      allow write: if request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && (
                     // Allow if content type is an image (if set)
                     !('contentType' in request.resource) ||
                     request.resource.contentType.matches('image/.*')
                   );
    }
    
    // Allow read access to menu images (public read)
    match /menuImages/{allPaths=**} {
      allow read: if true;
      // Allow write: Since app uses custom session auth (not Firebase Auth),
      // allow writes with file size and content type restrictions
      allow write: if request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && (
                     // Allow if content type is an image (if set)
                     !('contentType' in request.resource) ||
                     request.resource.contentType.matches('image/.*')
                   );
    }
    
    // Allow read/write access to payment settings (QR codes, etc.)
    match /paymentSettings/{fileName} {
      // Allow public read: QR codes need to be visible to customers
      allow read: if true;
      
      // Allow write: Since app uses custom session auth (not Firebase Auth),
      // allow writes with file size and content type restrictions
      allow write: if request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && (
                     // Allow if content type is an image (if set)
                     !('contentType' in request.resource) ||
                     request.resource.contentType.matches('image/.*')
                   );
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
